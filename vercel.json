{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/team/create", "destination": "/api/invitations/team-create?a=team-create" },
    { "source": "/api/team/password", "destination": "/api/invitations/team-password?a=team-password" },
    { "source": "/api/contact", "destination": "/api/public/contact?a=contact" },
    { "source": "/api/funnel", "destination": "/api/public/funnel?a=funnel" },
    { "source": "/api/quote", "destination": "/api/public/quote?a=quote" },
    { "source": "/api/plan-request", "destination": "/api/public/plan-request?a=plan-request" },
    { "source": "/c/:slug/manifest.webmanifest", "destination": "/api/portal/manifest?a=manifest&slug=:slug" },
    { "source": "/c/:slug", "destination": "/api/portal/page?a=page&slug=:slug" },
    { "source": "/c/:slug/:path*", "destination": "/api/portal/page?a=page&slug=:slug" },
    { "source": "/((?!api/|assets/|brand/|screens/|kiosk/|sw\\.js|manifest\\.webmanifest|robots\\.txt|sitemap\\.xml|.*\\.(?:png|webp|ico|js|css|webmanifest)$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    { "source": "/(c|app|admin|onboarding|convite|entrar|cadastro|recuperar-senha|nova-senha|checkout|proposta|contratar|org|validar)(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/screens/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/kiosk/(.*)", "headers": [{ "key": "Content-Type", "value": "application/vnd.android.package-archive" }, { "key": "Cache-Control", "value": "public, max-age=300" }, { "key": "X-Robots-Tag", "value": "noindex" }] }
  ],
  "crons": [{ "path": "/api/jobs/tick", "schedule": "17 9 * * *" }]
}

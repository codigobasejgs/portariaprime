# Frontend: URL e chave pública do NOVO projeto Supabase.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA
VITE_VAPID_PUBLIC_KEY=SUA_CHAVE_VAPID_PUBLICA

# Backend: mesmo projeto; nunca use prefixo VITE_ para a service role.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE
APP_URL=https://portariaprime.com.br

# Recebedor global Portaria Prime, nunca a conta do condomínio.
INFINITEPAY_HANDLE=SUA_INFINITETAG_SEM_CIFRAO
CRON_SECRET=SEGREDO_ALEATORIO_LONGO_DO_AGENDADOR

# Canais externos: não são chamados pelos testes locais de contrato.
RESEND_API_KEY=SUA_CHAVE_RESEND
RESEND_FROM_EMAIL=Portaria Prime <avisos@portariaprime.com.br>
EVOLUTION_API_URL=https://SEU_SERVIDOR_EVOLUTION
EVOLUTION_API_KEY=SUA_CHAVE_EVOLUTION
GEMINI_API_KEY=SUA_CHAVE_GEMINI
# Portaria Prime IA (motor Whaileys). PARTNER_KEY: chave de parceiro do motor, só alcança instâncias ppia-* (WhatsApp da IA de cada condomínio).
WHAILEYS_API_URL=https://SEU_MOTOR_WHAILEYS
WHAILEYS_PARTNER_KEY=CHAVE_DE_PARCEIRO_PPIA
# Opcional: número único da plataforma (reserva para condomínios sem WhatsApp próprio da IA).
WHAILEYS_INSTANCE=portaria-prime
WHAILEYS_TOKEN=TOKEN_DA_INSTANCIA
WHAILEYS_WEBHOOK_SECRET=SEGREDO_DO_WEBHOOK_DA_INSTANCIA
GEMINI_OCR_MODEL=MODELO_VALIDADO_NA_SUA_CONTA
VAPID_PRIVATE_KEY=SUA_CHAVE_VAPID_PRIVADA
VAPID_SUBJECT=mailto:suporte@SEU_DOMINIO
